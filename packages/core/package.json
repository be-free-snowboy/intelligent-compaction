{
    "name": "@intelligent-compact/core",
    "version": "1.0.0",
    "description": "Host-agnostic semantic compaction controller for coding agents.",
    "license": "MIT",
    "author": "snowboy",
    "type": "module",
    "keywords": [
        "intelligent-compact",
        "context",
        "compaction",
        "agent"
    ],
    "sideEffects": false,
    "private": false,
    "repository": {
        "type": "git",
        "url": "git+https://github.com/freestylejs/intelligent-compact.git",
        "directory": "packages/core"
    },
    "bugs": {
        "url": "https://github.com/freestylejs/intelligent-compact/issues"
    },
    "homepage": "https://github.com/freestylejs/intelligent-compact/tree/main/packages/core#readme",
    "engines": {
        "node": "^22.18.0 || ^24.11.0 || >=26.0.0"
    },
    "publishConfig": {
        "access": "public"
    },
    "files": [
        "dist"
    ],
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./dist/index.d.ts",
                "default": "./dist/index.js"
            },
            "require": {
                "types": "./dist/index.d.cts",
                "default": "./dist/index.cjs"
            }
        }
    },
    "scripts": {
        "build": "tsdown",
        "build:fast": "tsdown --no-dts",
        "dev": "tsdown --watch --sourcemap",
        "ts:typecheck": "tsc --noEmit --skipLibCheck"
    }
}
